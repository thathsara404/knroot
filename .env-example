# ── Application ────────────────────────────────────────────────────────────────
FLASK_ENV=development                          # development | production | testing

# ── Security ────────────────────────────────────────────────────────────────────
SESSION_SECRET_KEY=change-me-to-a-long-random-string

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres

# ── Redis ────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── LLM (chat + discuss + news curation) ────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=deepseek/deepseek-chat

# ── Fact-check pipeline (Google ADK + Gemini) ────────────────────────────────────
# Required to enable the [Fact Check] button on news articles.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-api-key-here
# Optional: override the Gemini model used for fact-checking
# FACT_CHECK_MODEL=gemini-2.0-flash

# ── Rate limiting ────────────────────────────────────────────────────────────────
# Set to false in E2E/testing environments to prevent rate limit interference
# RATELIMIT_ENABLED=true
