{
  "name": "knowledge-root",
  "private": true,
  "description": "Knowledge Root (knroot.com) — monorepo root. All dev, test, and Docker commands in one place. Delegates to Makefile.",
  "scripts": {
    "help": "make help",

    "--docker--": "# ── Docker (full stack) ─────────────────────────────────────────",
    "up":          "make up",
    "down":        "make down",
    "build":       "make build",
    "restart":     "make restart",
    "logs":        "make logs",

    "--infra--": "# ── Infra only (DB + Redis for local dev) ───────────────────────",
    "up:infra":    "make up-infra",

    "--dev--": "# ── Local dev servers ──────────────────────────────────────────────",
    "start:backend":   "make start-backend",
    "start:frontend":  "make start-frontend",

    "--tests--": "# ── Tests ──────────────────────────────────────────────────────────",
    "test":                  "make test",
    "test:backend:unit":     "make test-backend-unit",
    "test:backend:int":      "make test-backend-int",
    "test:frontend":         "make test-frontend",
    "test:e2e":              "make test-e2e",

    "--lint--": "# ── Lint ────────────────────────────────────────────────────────────",
    "lint":            "make lint",
    "lint:backend":    "make lint-backend",
    "lint:frontend":   "make lint-frontend",

    "--utils--": "# ── Utils ───────────────────────────────────────────────────────────",
    "db:shell":    "make db-shell",
    "redis:shell": "make redis-shell"
  }
}
